# Salin ke backend/.env dan isi dengan kunci milikmu sendiri.
# Jangan pernah commit file .env — hanya berkas contoh ini yang masuk repo.

# --- Database (Supabase / PostgreSQL) ---
# Kosongkan untuk menjalankan tanpa database. Audit tetap dihitung dan
# dikembalikan, hanya tidak tersimpan.
#
# Pakai connection string "Transaction pooler" dari Supabase
# (Project Settings > Database > Connection string > Transaction pooler,
# port 6543). Backend otomatis menonaktifkan prepared statement cache untuk
# pooler tersebut. Tabel dibuat otomatis saat start (lihat schema.sql).
# Contoh:
# DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Server ---
PORT=8000
LOG_LEVEL=INFO

# Origin frontend yang boleh memanggil API. Pisahkan dengan koma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Screening vs workflow teknis.
# best_available = boleh memakai proxy berlabel provisional.
# strict = tidak menerbitkan score bila layer kritis tidak tersedia.
AUDIT_DATA_MODE=best_available

# --- Gemini server-side only ---
# AI hanya menjelaskan hasil audit deterministik. Kunci ini tidak boleh masuk
# ke frontend atau disimpan di Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Fallback tambahan (opsional), dicoba berurutan setelah GEMINI_FALLBACK_MODEL.
# Pisahkan dengan koma. Contoh: gemini-2.5-flash,gemini-2.0-flash
GEMINI_FALLBACK_MODELS=

# --- OpenRouter fallback (server-side only) ---
# Tier terakhir: dicoba otomatis setelah seluruh chain Gemini gagal
# (rate limit, down, timeout, atau kunci ditolak). Kosongkan untuk
# menonaktifkan. Contoh model: stealth/ox-alpha, google/gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/ox-alpha

# --- AI runtime ---
AI_THINKING_LEVEL=low
AI_TIMEOUT_SECONDS=35
AI_MAX_RETRIES=1
AI_RATE_LIMIT_PER_MINUTE=15

# --- Competition resilience ---
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=604800
AI_REDACT_LOCATION=true
AI_PROMPT_VERSION=competition-v1

# Optional legacy diagnostic only. Never commit a real token.
# FREELLMAPI_TOKEN=
