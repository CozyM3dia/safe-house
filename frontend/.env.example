# Salin ke frontend/.env. Tidak ada kunci rahasia di sisi frontend —
# semua panggilan berbayar lewat backend.

# Alamat backend FastAPI.
# Lokal: http://localhost:8000
# Emergent (prod): KOSONGKAN — /api/* di-proxy ke backend pada origin yang sama.
# Jangan isi URL Vercel-only di sini.
VITE_API_URL=http://localhost:8000

# Canonical publik untuk meta OG di index.html (build-time).
# Default build: https://safehouse-pull.emergent.host
# Jangan pakai https://safehouse.web.id sebelum DNS hidup (NXDOMAIN).
VITE_PUBLIC_SITE_URL=

# Optional: Stadia Alidade Smooth / Alidade Smooth Dark.
# Restrict the Preview/production key by domain.
VITE_STADIA_MAPS_API_KEY=
