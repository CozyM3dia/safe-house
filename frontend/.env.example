# Salin ke frontend/.env. Jangan commit file .env.

# Alamat backend FastAPI.
VITE_API_URL=http://localhost:8000

# Produksi: isi dengan URL backend yang ter-deploy, mis.
# VITE_API_URL=https://safe-house-api.onrender.com

# Stadia Maps bersifat opt-in. CARTO tetap default sampai tile Stadia
# berhasil diverifikasi pada build yang benar-benar ter-deploy.
VITE_STADIA_MAPS_ENABLED=false

# Opsional untuk local/testing. Browser key bukan secret; batasi key ke
# domain deployment di dashboard Stadia. Untuk produksi web, domain
# authentication lebih disarankan dan key ini dapat dibiarkan kosong.
VITE_STADIA_MAPS_API_KEY=
